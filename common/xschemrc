# Course-wide XSchem configuration.
# Selected by XSCHEMRC in common/.designinit.
#
# This file layers course settings on top of the SKY130 PDK's own xschemrc.
# Setting XSCHEMRC bypasses the PDK file, so we source it explicitly first --
# that is what supplies the sky130 device symbols and the standard library path.

set pdk_root [expr {[info exists ::env(PDK_ROOT)] ? $::env(PDK_ROOT) : "/foss/pdks"}]
set pdk      [expr {[info exists ::env(PDK)]      ? $::env(PDK)      : "sky130A"}]
set pdk_xschemrc ${pdk_root}/${pdk}/libs.tech/xschem/xschemrc

if {[file exists $pdk_xschemrc]} {
    source $pdk_xschemrc
} else {
    puts "ECE334 xschemrc: WARNING no PDK xschemrc at $pdk_xschemrc"
    set XSCHEM_LIBRARY_PATH {}
    append XSCHEM_LIBRARY_PATH :${XSCHEM_SHAREDIR}/xschem_library/devices
    append XSCHEM_LIBRARY_PATH :${XSCHEM_SHAREDIR}/xschem_library
}

# Course symbol libraries.  Entries MUST be colon-separated: appending without
# the ":" concatenates paths into one unusable string, which makes every local
# symbol netlist as "IS MISSING !!!!".
append XSCHEM_LIBRARY_PATH :/foss/designs
append XSCHEM_LIBRARY_PATH :/foss/designs/common
append XSCHEM_LIBRARY_PATH :/foss/designs/common/xschem

# Each lab keeps its schematics and DUT symbols in <lab>/xschem.  Add them so a
# testbench can refer to a sibling symbol by bare name (e.g. "dut_inv.sym").
#
# These directories all share one flat namespace, and an earlier entry wins, so
# a cell name used by two labs would silently resolve to the wrong file. Cells
# shared between labs therefore live in common/xschem, not in a lab folder.
foreach labdir [lsort [glob -nocomplain -directory /foss/designs -type d {lab*}]] {
    if {[file isdirectory ${labdir}/xschem]} {
        append XSCHEM_LIBRARY_PATH :${labdir}/xschem
    }
}

# The PDK sets XSCHEM_START_WINDOW to its own read-only test schematic, which
# xschem opens on startup and then raises a "Save file" browser over. Students
# open their own testbench, so clear it.
set XSCHEM_START_WINDOW {}

# One well-known place for netlists and simulation results, regardless of which
# directory XSchem was started from. The notebooks resolve result files against
# this same path via ece334lib.sim.raw(), so the launcher buttons and the
# analysis always agree.
set netlist_dir /foss/designs/.xschem/simulations
file mkdir $netlist_dir

# ngspice is the course simulator.
set netlist_type spice
set netlist_command {ngspice -b -o %o %n}

